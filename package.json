{
  "name": "nextflow-wrap",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:real": "NEXT_PUBLIC_API_MOCKING=disabled next dev --hostname 127.0.0.1",
    "runner": "tsx scripts/runner.ts",
    "build": "next build",
    "build:real": "NEXT_PUBLIC_API_MOCKING=disabled next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "eslint",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "sync:modules": "node scripts/sync-nf-core-modules.mjs",
    "smoke:nextflow": "tsx scripts/smoke-nextflow.ts",
    "smoke:runner": "tsx scripts/smoke-runner.ts",
    "codex:smoke": "tsx scripts/codex-smoke.ts"
  },
  "dependencies": {
    "@copilotkit/react-core": "1.83.0",
    "@copilotkit/runtime": "1.83.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/addon-docs": "^10.6.5",
    "@storybook/nextjs-vite": "^10.6.5",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "msw": "^3.0.3",
    "storybook": "^10.6.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
