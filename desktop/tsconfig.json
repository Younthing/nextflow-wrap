{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": ["src/**/*.ts", "../src/features/desktop/*.ts", "../src/features/server/serve-config.ts", "../src/lib/desktop.ts", "../src/lib/api-types.ts", "../src/lib/product-theme/index.ts"],
  "exclude": ["../src/**/*.test.ts"]
}
