# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static
storybook-static
*storybook.log

# CodeGraph local index (https://github.com/colbymchenry/codegraph)
.codegraph/

# Local Nextflow work directories for pattern checks
.nf-verify/
# Nextflow scratch folders left by an interrupted run in the repository root
/nxf-tmp.*
/.nextflow/
/.nextflow.log*

# Playwright user-path runs
/test-results/
/playwright-report/
/playwright-report-desktop/
/blob-report/
/e2e-artifacts/

# Desktop build output
/desktop/node_modules/
/desktop/dist/
/desktop/resources/
/desktop/release/

# standalone server package (scripts/build-server.mjs)
/dist-server
